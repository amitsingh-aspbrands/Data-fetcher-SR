# Shiprocket API Credentials
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git (it contains secrets)

SHIPROCKET_EMAIL=your_email@example.com
SHIPROCKET_PASSWORD=your_password_here

# Auth API (for login/token)
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# E360 Marketing API (for automation data)
E360_BASE_URL=https://e360-marketing-api.shiprocket.in
E360_CHANNEL_ID=your_channel_id_here

# Which automation rules to track (comma-separated IDs)
EVENT_RULE_IDS=65459,65461

# Pickrr Reporting API
PICKRR_BASE_URL=https://reporting.pickrr.com/api/ve1
PICKRR_DOMAIN=includ.com
PICKRR_COMPANY_ID=your_company_id_here
PICKRR_XAUTH_TOKEN=your_static_xauth_token_here

# How many days back to fetch (not counting today)
LOOKBACK_DAYS=7

# Output Configuration
OUTPUT_DIR=output
LOG_DIR=logs
